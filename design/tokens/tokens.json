{
  "$comment": "aidog 设计 token 单一真值源（票 10）。与语言无关：Web 侧从这里生成，不允许手写第二份。改这里 → 跑 node build-tokens.mjs。",
  "$meta": {
    "direction": "G3 · 观测台（白底紫 #7A46C9 / dark 石墨夜 #16181D，2026-10-24 拍板，真值表见 .scratch/重设计-终稿/6-整体风格与分组页.html 第二节）",
    "modes": [
      "dark",
      "light"
    ],
    "rule": "主色两模式都是饱和紫；dark 语义色全体调亮一档保 4.5:1；光晕/描边跟主色走。"
  },
  "color": {
    "$comment": "两套模式必须一一对应，禁止某一侧独有的 key。",
    "bg": {
      "dark": "#16181D",
      "light": "#F6F7F9",
      "use": "页面底"
    },
    "bg-chrome": {
      "dark": "#16181D",
      "light": "#FAFBFC",
      "use": "侧栏 / 顶栏底"
    },
    "surface": {
      "dark": "#1E2127",
      "light": "#FFFFFF",
      "use": "卡面"
    },
    "surface-2": {
      "dark": "#262A32",
      "light": "#F1F3F6",
      "use": "次表面 / hover 底"
    },
    "line": {
      "dark": "#2A2E36",
      "light": "#E3E7EC",
      "use": "边"
    },
    "line-strong": {
      "dark": "#3A404C",
      "light": "#C9D2DD",
      "use": "输入框边 / 强边"
    },
    "fg": {
      "dark": "#E4E7EC",
      "light": "#1C2430",
      "use": "主文字"
    },
    "fg-2": {
      "dark": "#8E98A6",
      "light": "#5B6878",
      "use": "辅助文字（对齐 4.5:1）"
    },
    "fg-3": {
      "dark": "#78818E",
      "light": "#6B7686",
      "use": "标签 / 刻度"
    },
    "accent": {
      "dark": "#8B5CD9",
      "light": "#7A46C9",
      "use": "主色（选中/主按钮/流线）"
    },
    "accent-edge": {
      "dark": "rgba(139,92,217,.45)",
      "light": "#7A46C9",
      "use": "强调描边。G3 主色对底 >3:1，自身可当边；dark 用 45% 焦点环级"
    },
    "accent-text": {
      "dark": "#A377E8",
      "light": "#7A46C9",
      "use": "accent 当文字/图标用（dark 更亮一档，chart-2 同源）"
    },
    "accent-wash": {
      "dark": "rgba(139,92,217,.14)",
      "light": "rgba(122,70,201,.10)",
      "use": "hover/选中淡底（--accent-subtle，替代旧 bg-accent 误用）"
    },
    "glow": {
      "dark": "rgba(139,92,217,1)",
      "light": "rgba(122,70,201,1)",
      "use": "光晕色源（G3 回归主色系；alpha 由 bgOverlays 各层给）"
    },
    "data-primary": {
      "dark": "#8B5CD9",
      "light": "#7A46C9",
      "use": "图表序列 1（=主色）"
    },
    "ok": {
      "dark": "#3E9E6F",
      "light": "#1F9D61",
      "use": "成功（dark 调亮一档保 4.5:1）"
    },
    "peak": {
      "dark": "#D9963C",
      "light": "#C77E1E",
      "use": "高峰 / 警告（dark 调亮一档）"
    },
    "peak-idle": {
      "dark": "rgba(255,255,255,.06)",
      "light": "#E7E9EC",
      "use": "24 段时钟带的非高峰段"
    },
    "bad": {
      "dark": "#E06A6A",
      "light": "#D14B4B",
      "use": "失败 / 危险（dark 调亮一档）"
    },
    "live-halo": {
      "dark": "0 0 18px -6px rgba(139,92,217,.55)",
      "light": "none",
      "use": "状态点光晕。light 无光（白底降对比），由 live-fill 顶上"
    },
    "live-ring": {
      "dark": "0 0 0 3px rgba(62,158,111,.20)",
      "light": "0 0 0 3px rgba(31,157,97,.22)",
      "use": "状态点呼吸环（跟 ok 色）"
    },
    "live-fill": {
      "dark": "rgba(139,92,217,.16)",
      "light": "rgba(122,70,201,.10)",
      "use": "活着提示的底（主色系）"
    },
    "live-edge": {
      "dark": "rgba(139,92,217,.45)",
      "light": "rgba(122,70,201,.35)",
      "use": "焦点环 / 活着的边（G3 表：ring 紫35%/45%）"
    },
    "shadow-tile": {
      "dark": "none",
      "light": "0 1px 3px rgba(28,36,48,.05)",
      "use": "卡面微阴影（G3 表：0 1px 3px 5%）"
    },
    "shadow-float": {
      "dark": "0 16px 40px -12px rgba(0,0,0,.55)",
      "light": "0 16px 40px -14px rgba(28,36,48,.14)",
      "use": "弹层（G3 表：0 16px 40px 14%）"
    },
    "shadow-rail-card": {
      "dark": "0 1px 3px rgba(0,0,0,.4)",
      "light": "0 1px 3px rgba(28,36,48,.05)",
      "use": "侧栏卡 --shadow-sm 源"
    },
    "destructive": {
      "dark": "#E06A6A",
      "light": "#D14B4B",
      "use": "实心删除底色（=bad）"
    },
    "chart-2": {
      "dark": "#A377E8",
      "light": "#A377E8",
      "use": "图表序列 2（亮紫）"
    },
    "chart-3": {
      "dark": "#6E9AE8",
      "light": "#3D74D6",
      "use": "图表序列 3（蓝）"
    },
    "chart-4": {
      "dark": "#D9963C",
      "light": "#C77E1E",
      "use": "图表序列 4（琥珀）"
    }
  },
  "space": {
    "$comment": "只有 7 档，页面里禁止出现档外数值。8 档是 React 最高频的 gap（ImportExport / DonutChart 图例 / ItemSelector 全用 gap:8），没有它就会就近取 6。",
    "xs": 4,
    "sm": 6,
    "8": 8,
    "md": 10,
    "lg": 14,
    "xl": 18,
    "2xl": 24
  },
  "layout": {
    "rail-w": 200,
    "rail-w-collapsed": 56,
    "shell-inset": 12,
    "shell-gap": 12,
    "grid-cols": 12,
    "grid-gap": 10,
    "tile-pad-x": 16,
    "tile-pad-y": 14,
    "page-pad-x": 32,
    "page-pad-y": 24,
    "row-h": 9,
    "content-max": 1180,
    "tray-w": 328,
    "breakpoint-narrow": 940
  },
  "radius": {
    "$comment": "G3 真值表：--radius 8px（卡 10 / 按钮 7 / 徽标 4）。",
    "sm": 7,
    "md": 10,
    "lg": 16,
    "xl": 24,
    "pill": 999
  },
  "type": {
    "$comment": "G3：IBM Plex Sans（界面）/ IBM Plex Mono（数值、协议名、密钥、标签）；自托管 woff2，回退链含 PingFang SC。字号下限 12px。",
    "family-sans": "'IBM Plex Sans', Inter, -apple-system, system-ui, 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "family-mono": "'IBM Plex Mono', 'SF Mono', ui-monospace, monospace",
    "display": {
      "size": 22,
      "weight": 600,
      "tracking": -0.025,
      "mono": false
    },
    "title": {
      "size": 15,
      "weight": 600,
      "tracking": -0.015,
      "mono": false
    },
    "tile": {
      "size": 13,
      "weight": 600,
      "tracking": 0,
      "mono": false
    },
    "body": {
      "size": 13,
      "weight": 400,
      "tracking": -0.011,
      "mono": false
    },
    "label": {
      "size": 12.5,
      "weight": 400,
      "tracking": 0,
      "mono": false
    },
    "caption": {
      "size": 12,
      "weight": 400,
      "tracking": 0,
      "mono": false
    },
    "micro": {
      "size": 11,
      "weight": 500,
      "tracking": 0.06,
      "mono": false,
      "upper": true
    },
    "num-xl": {
      "size": 28,
      "weight": 600,
      "tracking": -0.03,
      "mono": true
    },
    "num-lg": {
      "size": 18.5,
      "weight": 600,
      "tracking": -0.03,
      "mono": true
    },
    "num-md": {
      "size": 13.5,
      "weight": 400,
      "tracking": -0.02,
      "mono": true
    },
    "num-sm": {
      "size": 12.5,
      "weight": 400,
      "tracking": -0.02,
      "mono": true
    }
  },
  "motion": {
    "instant": 0,
    "fast": 140,
    "base": 180,
    "slow": 260,
    "breathe": 3000,
    "ease-standard": [
      0.2,
      0.0,
      0.0,
      1.0
    ],
    "ease-exit": [
      0.4,
      0.0,
      1.0,
      1.0
    ]
  }
