{
  "$comment": "aidog 设计 token 单一真值源（票 10）。与语言无关：Flutter 侧与 Web 侧都从这里生成，不允许任何一侧手写第二份。改这里 → 跑 node build-tokens.mjs。",
  "$meta": {
    "direction": "A′ · Bento Flux（保留侧栏版）",
    "modes": [
      "dark",
      "light"
    ],
    "rule": "深色用光表达「活着」，浅色用色表达「活着」。glow 系 token 在 light 下被置空，由 fill/ring 顶上。"
  },
  "color": {
    "$comment": "两套模式必须一一对应，禁止某一侧独有的 key。",
    "bg": {
      "dark": "#08090A",
      "light": "#F4F5F7",
      "use": "窗口底"
    },
    "bg-chrome": {
      "dark": "#0C0D0F",
      "light": "#FAFAFB",
      "use": "标题栏 / 侧栏底"
    },
    "surface": {
      "dark": "#111214",
      "light": "#FFFFFF",
      "use": "格子表面"
    },
    "surface-2": {
      "dark": "#16171A",
      "light": "#F1F2F4",
      "use": "格子 hover / 内嵌块"
    },
    "line": {
      "dark": "rgba(255,255,255,.07)",
      "light": "rgba(9,10,12,.10)",
      "use": "hairline 分隔"
    },
    "line-strong": {
      "dark": "rgba(255,255,255,.12)",
      "light": "rgba(9,10,12,.17)",
      "use": "格子边 / 表头下边"
    },
    "fg": {
      "dark": "#F7F8F8",
      "light": "#14161A",
      "use": "正文与读数"
    },
    "fg-2": {
      "dark": "#9BA1A6",
      "light": "#5B6169",
      "use": "次级文字"
    },
    "fg-3": {
      "dark": "#62676C",
      "light": "#8A9099",
      "use": "标签 / 刻度"
    },
    "accent": {
      "dark": "#101012",
      "light": "#4E59C4",
      "use": "填充、图表描边、进度条"
    },
    "accent-edge": {
      "dark": "rgba(255,255,255,.34)",
      "light": "#4E59C4",
      "use": "强调用的描边色。深色下 accent 是近黑，面本身对底只有 1.05:1，轮廓全靠这圈白边（压在 accent 上 3.22:1、压在 surface 上 3.11:1，都过 1.4.11 的 3:1）；浅色下 accent 本身就有 5.92:1（对白）/ 5.42:1（对窗口底），直接用它当边，别换成灰线——灰线只有 1.36:1，标不住选中态"
    },
    "accent-text": {
      "dark": "#E6E8EC",
      "light": "#3F47A6",
      "use": "accent 当文字用（深色要更亮、浅色要更暗）"
    },
    "accent-wash": {
      "dark": "rgba(255,255,255,.06)",
      "light": "rgba(78,89,196,.10)",
      "use": "活着的格子的底色。深色侧必须比 surface-2（≈白 4%）更亮，否则鼠标悬停比选中还显眼"
    },
    "glow": {
      "dark": "rgba(255,255,255,1)",
      "light": "rgba(9,10,12,1)",
      "use": "窗口底光晕的色源（alpha 由 bgOverlays 各层自己给）。与 accent 解耦：accent 是近黑时，跟着它走的光晕对窗口底只有 1.006:1，等于没画"
    },
    "data-primary": {
      "dark": "#5E6AD2",
      "light": "#4E59C4",
      "use": "图表主系列色。唯一不跟随 accent 单色化的地方：多条折线必须靠色相分开，灰阶只够分 2~3 条"
    },
    "ok": {
      "dark": "#5A8A6A",
      "light": "#6B9E7A",
      "use": "代理运行中 / 成功率（React globals.css --color-success 莫兰迪现值，2026-09-25 批次一对齐）"
    },
    "peak": {
      "dark": "#B8984A",
      "light": "#C9A35C",
      "use": "高峰窗口 / 警告（React globals.css --color-warning 莫兰迪现值，2026-09-25 批次一对齐）"
    },
    "peak-idle": {
      "dark": "rgba(255,255,255,.05)",
      "light": "#E7E9EC",
      "use": "24 段时钟带的非高峰段"
    },
    "bad": {
      "dark": "#B07070",
      "light": "#C47A7A",
      "use": "失败 / 下降（React globals.css --color-danger 莫兰迪现值，2026-09-25 批次一对齐）"
    },
    "live-halo": {
      "dark": "0 0 18px -6px rgba(255,255,255,.55)",
      "light": "none",
      "use": "★ 唯一不跨模式的 token：光在白底上等于降对比，light 置 none。深色侧色源与 glow 同理是白系：accent 是近黑之后，跟着旧蓝紫走的光既不自洽也几乎不可见"
    },
    "live-ring": {
      "dark": "0 0 0 3px rgba(90,138,106,.16)",
      "light": "0 0 0 3px rgba(107,158,122,.18)",
      "use": "状态点的呼吸环，两模式都成立"
    },
    "live-fill": {
      "dark": "rgba(255,255,255,.13)",
      "light": "rgba(78,89,196,.09)",
      "use": "浅色下接替 halo 的表达：不发光，改上色。深色侧换白系（alpha 不动）：压在 surface 上出 #303133，对表面 1.44:1，旧蓝紫只有 1.12:1"
    },
    "live-edge": {
      "dark": "rgba(255,255,255,.25)",
      "light": "rgba(78,89,196,.40)",
      "use": "活着的格子的边，浅色下要更实。深色侧换白系（alpha 不动）：压在 surface 上出 #4C4D4F，对表面 2.21:1（旧蓝紫 1.30:1）。仍不到 1.4.11 的 3:1 —— 它是装饰性的「活着」提示，不是唯一状态指示，格子里另有状态点与文案"
    },
    "shadow-tile": {
      "dark": "none",
      "light": "0 1px 2px rgba(9,10,12,.05)",
      "use": "浅色下格子靠微阴影浮起，深色下靠表面亮度"
    },
    "shadow-float": {
      "dark": "0 24px 64px -16px rgba(0,0,0,.9)",
      "light": "0 18px 44px -14px rgba(9,10,12,.22)",
      "use": "托盘小窗"
    },
    "destructive": {
      "dark": "#EB5757",
      "light": "#C93B3B",
      "use": "shadcn --destructive（删除类实心按钮）。React 状态色走莫兰迪 bad，但实心按钮底色保持饱和红（白字对 #C47A7A 只有 ~3.4:1，会退 4.5:1）；mono.ts 的 --destructive 从这里取，与旧 bad 值一字不差"
    }
  },
  "space": {
    "$comment": "只有 6 档，页面里禁止出现档外数值。",
    "xs": 4,
    "sm": 6,
    "md": 10,
    "lg": 14,
    "xl": 18,
    "2xl": 24
  },
  "layout": {
    "rail-w": 200,
    "rail-w-collapsed": 56,
    "titlebar-h": 40,
    "grid-cols": 12,
    "grid-gap": 10,
    "tile-pad-x": 16,
    "tile-pad-y": 14,
    "page-pad": 18,
    "row-h": 9,
    "content-max": 1180,
    "tray-w": 328,
    "breakpoint-narrow": 940
  },
  "radius": {
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 14,
    "pill": 999
  },
  "type": {
    "$comment": "family 两条：sans 走比例字（中文混排），mono 只跑数字与全大写标签。",
    "family-sans": "Inter, -apple-system, system-ui, 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "family-mono": "'JetBrains Mono', ui-monospace, monospace",
    "display": {
      "size": 24,
      "weight": 600,
      "tracking": -0.025,
      "mono": false
    },
    "title": {
      "size": 16.5,
      "weight": 600,
      "tracking": -0.015,
      "mono": false
    },
    "tile": {
      "size": 13.5,
      "weight": 600,
      "tracking": 0,
      "mono": false
    },
    "body": {
      "size": 15,
      "weight": 400,
      "tracking": -0.011,
      "mono": false
    },
    "label": {
      "size": 13.5,
      "weight": 400,
      "tracking": 0,
      "mono": false
    },
    "caption": {
      "size": 12.5,
      "weight": 400,
      "tracking": 0,
      "mono": false
    },
    "micro": {
      "size": 11,
      "weight": 500,
      "tracking": 0.06,
      "mono": false,
      "upper": true
    },
    "num-xl": {
      "size": 28,
      "weight": 600,
      "tracking": -0.03,
      "mono": true
    },
    "num-lg": {
      "size": 18.5,
      "weight": 600,
      "tracking": -0.03,
      "mono": true
    },
    "num-md": {
      "size": 13.5,
      "weight": 400,
      "tracking": -0.02,
      "mono": true
    },
    "num-sm": {
      "size": 12.5,
      "weight": 400,
      "tracking": -0.02,
      "mono": true
    }
  },
  "motion": {
    "instant": 0,
    "fast": 140,
    "base": 180,
    "slow": 260,
    "breathe": 3000,
    "ease-standard": [
      0.2,
      0.0,
      0.0,
      1.0
    ],
    "ease-exit": [
      0.4,
      0.0,
      1.0,
      1.0
    ]
  }
}
