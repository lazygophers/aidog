{
  "$comment": "aidog 设计 token 单一真值源（票 10）。与语言无关：Flutter 侧与 Web 侧都从这里生成，不允许任何一侧手写第二份。改这里 → 跑 node build-tokens.mjs。",
  "$meta": {
    "direction": "A′ · Bento Flux（保留侧栏版）",
    "modes": ["dark", "light"],
    "rule": "深色用光表达「活着」，浅色用色表达「活着」。glow 系 token 在 light 下被置空，由 fill/ring 顶上。"
  },

  "color": {
    "$comment": "两套模式必须一一对应，禁止某一侧独有的 key。",
    "bg":            { "dark": "#08090A", "light": "#F4F5F7", "use": "窗口底" },
    "bg-chrome":     { "dark": "#0C0D0F", "light": "#FAFAFB", "use": "标题栏 / 侧栏底" },
    "surface":       { "dark": "#111214", "light": "#FFFFFF", "use": "格子表面" },
    "surface-2":     { "dark": "#16171A", "light": "#F1F2F4", "use": "格子 hover / 内嵌块" },
    "line":          { "dark": "rgba(255,255,255,.07)", "light": "rgba(9,10,12,.10)", "use": "hairline 分隔" },
    "line-strong":   { "dark": "rgba(255,255,255,.12)", "light": "rgba(9,10,12,.17)", "use": "格子边 / 表头下边" },
    "fg":            { "dark": "#F7F8F8", "light": "#14161A", "use": "正文与读数" },
    "fg-2":          { "dark": "#9BA1A6", "light": "#5B6169", "use": "次级文字" },
    "fg-3":          { "dark": "#62676C", "light": "#8A9099", "use": "标签 / 刻度" },

    "accent":        { "dark": "#5E6AD2", "light": "#4E59C4", "use": "填充、图表描边、进度条" },
    "accent-text":   { "dark": "#8A91E8", "light": "#3F47A6", "use": "accent 当文字用（深色要更亮、浅色要更暗）" },
    "accent-wash":   { "dark": "rgba(94,106,210,.16)", "light": "rgba(78,89,196,.10)", "use": "活着的格子的底色" },

    "ok":            { "dark": "#4CB782", "light": "#2E9367", "use": "代理运行中 / 成功率" },
    "peak":          { "dark": "#F2C94C", "light": "#E9A400", "use": "高峰窗口（浅色下黄色必须压暗加饱和，否则消失）" },
    "peak-idle":     { "dark": "rgba(255,255,255,.05)", "light": "#E7E9EC", "use": "24 段时钟带的非高峰段" },
    "bad":           { "dark": "#EB5757", "light": "#C93B3B", "use": "失败 / 下降" },

    "live-halo":     { "dark": "0 0 18px -6px rgba(94,106,210,.55)", "light": "none", "use": "★ 唯一不跨模式的 token：光在白底上等于降对比，light 置 none" },
    "live-ring":     { "dark": "0 0 0 3px rgba(76,183,130,.16)", "light": "0 0 0 3px rgba(46,147,103,.18)", "use": "状态点的呼吸环，两模式都成立" },
    "live-fill":     { "dark": "rgba(94,106,210,.13)", "light": "rgba(78,89,196,.09)", "use": "浅色下接替 halo 的表达：不发光，改上色" },
    "live-edge":     { "dark": "rgba(94,106,210,.25)", "light": "rgba(78,89,196,.40)", "use": "活着的格子的边，浅色下要更实" },

    "shadow-tile":   { "dark": "none", "light": "0 1px 2px rgba(9,10,12,.05)", "use": "浅色下格子靠微阴影浮起，深色下靠表面亮度" },
    "shadow-float":  { "dark": "0 24px 64px -16px rgba(0,0,0,.9)", "light": "0 18px 44px -14px rgba(9,10,12,.22)", "use": "托盘小窗" }
  },

  "space": {
    "$comment": "只有 6 档，页面里禁止出现档外数值。",
    "xs": 4, "sm": 6, "md": 10, "lg": 14, "xl": 18, "2xl": 24
  },

  "layout": {
    "rail-w": 200,
    "rail-w-collapsed": 56,
    "titlebar-h": 40,
    "grid-cols": 12,
    "grid-gap": 10,
    "tile-pad-x": 16,
    "tile-pad-y": 14,
    "page-pad": 18,
    "row-h": 9,
    "content-max": 1180,
    "tray-w": 328,
    "breakpoint-narrow": 940
  },

  "radius": { "sm": 6, "md": 8, "lg": 12, "xl": 14, "pill": 999 },

  "type": {
    "$comment": "family 两条：sans 走比例字（中文混排），mono 只跑数字与全大写标签。",
    "family-sans": "Inter, -apple-system, system-ui, 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "family-mono": "'JetBrains Mono', ui-monospace, monospace",
    "display":  { "size": 22,   "weight": 600, "tracking": -0.025, "mono": false },
    "title":    { "size": 15,   "weight": 600, "tracking": -0.015, "mono": false },
    "tile":     { "size": 12.5, "weight": 600, "tracking": 0,      "mono": false },
    "body":     { "size": 14,   "weight": 400, "tracking": -0.011, "mono": false },
    "label":    { "size": 12.5, "weight": 400, "tracking": 0,      "mono": false },
    "caption":  { "size": 11.5, "weight": 400, "tracking": 0,      "mono": false },
    "micro":    { "size": 10.5, "weight": 500, "tracking": 0.06,   "mono": false, "upper": true },
    "num-xl":   { "size": 26,   "weight": 600, "tracking": -0.03,  "mono": true },
    "num-lg":   { "size": 17,   "weight": 600, "tracking": -0.03,  "mono": true },
    "num-md":   { "size": 12.5, "weight": 400, "tracking": -0.02,  "mono": true },
    "num-sm":   { "size": 11.5, "weight": 400, "tracking": -0.02,  "mono": true }
  },

  "motion": {
    "instant": 0,
    "fast": 140,
    "base": 180,
    "slow": 260,
    "breathe": 3000,
    "ease-standard": [0.2, 0.0, 0.0, 1.0],
    "ease-exit": [0.4, 0.0, 1.0, 1.0]
  }
}
