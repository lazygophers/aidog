{
    "_aidog_preset_name": "Open-source default",
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "autoConnectIde": false,
    "disableClaudeAiConnectors": true,
    "isolatePeerMachines": true,
    "disableDeepLinkRegistration": "disable",
    "cleanupPeriodDays": 30,
    "feedbackSurveyRate": 0,
    "agentPushNotifEnabled": false,
    "enableArtifact": false,
    "disableArtifact": true,
    "_aidog_statusline": {
        "enabled": true
    },
    "_aidog_hooks": {
        "enabled": true
    },
    "sandbox": {
        "enabled": false,
        "filesystem": {
            "denyRead": [
                "~/.aws",
                "~/.config/gcloud",
                "~/.claude/.credentials.json",
                "~/.netrc",
                "~/.pgpass",
                "~/.kdbx"
            ],
            "allowWrite": [
                "/tmp",
                "/private/tmp",
                "~/.cache",
                "~/.local",
                "~/.config",
                "~/Library/Caches",
                "~/.mise",
                "~/.asdf",
                "~/.nvm",
                "~/.fnm",
                "~/.volta",
                "~/.pyenv",
                "~/.rbenv",
                "~/.nodenv",
                "~/.goenv",
                "~/.jenv",
                "~/.sdkman",
                "~/.npm",
                "~/.yarn",
                "~/.pnpm-store",
                "~/.bun",
                "~/.deno",
                "~/.cargo",
                "~/.rustup",
                "~/go",
                "~/.gradle",
                "~/.m2",
                "~/.ivy2",
                "~/.sbt",
                "~/.gem",
                "~/.bundle",
                "~/.composer",
                "~/.nuget",
                "~/.dotnet",
                "~/.pub-cache",
                "~/.cocoapods",
                "~/.stack",
                "~/.cabal",
                "~/.opam",
                "~/.conda",
                "~/.docker",
                "~/.terraform.d"
            ]
        },
        "network": {
            "allowedDomains": [
                "*"
            ],
            "allowLocalBinding": true,
            "allowAllUnixSockets": true
        }
    },
    "permissions": {
        "deny": [
            "Read(~/.netrc)",
            "Read(**/.mcp.json)",
            "Read(**/.env)",
            "Read(**/.env.*)",
            "Read(**/.env.local)",
            "Read(**/*.key)",
            "Read(**/*.pem)",
            "Read(**/*.p12)",
            "Read(**/*.pfx)",
            "Read(**/credentials.json)",
            "Read(**/service-account*.json)",
            "Read(**/.htpasswd)",
            "Read(**/id_rsa)",
            "Read(**/id_ed25519)",
            "Read(**/id_ecdsa)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.config/gcloud/**)",
            "Read(~/.kube/config)",
            "Read(~/.claude/.credentials.json)",
            "Read(**/.git-credentials)",
            "Read(**/.netrc)",
            "Read(**/.npmrc)",
            "Read(**/.pgpass)",
            "Read(**/*.kdbx)",
            "Edit(**/go.sum)",
            "Edit(**/mise.toml)",
            "Edit(**/yarn.lock)",
            "Edit(**/package-lock.json)",
            "Edit(**/pnpm-lock.yaml)",
            "Edit(**/Cargo.lock)",
            "Edit(**/composer.lock)",
            "Edit(**/Podfile.lock)",
            "Edit(**/poetry.lock)",
            "Edit(**/uv.lock)",
            "Edit(**/bun.lockb)",
            "Edit(**/bun.lock)",
            "Edit(**/deno.lock)",
            "Edit(**/flake.lock)",
            "Edit(**/gradle.lockfile)",
            "Edit(**/packages.lock.json)",
            "Edit(**/mix.lock)",
            "Edit(**/.terraform.lock.hcl)",
            "Edit(**/node_modules/**)",
            "Edit(**/vendor/**)",
            "Edit(**/bower_components/**)",
            "Edit(**/.yarn/**)",
            "Edit(**/.pnpm-store/**)",
            "Edit(**/.venv/**)",
            "Edit(**/site-packages/**)",
            "Edit(**/Pods/**)",
            "Edit(~/.cargo/registry/**)",
            "Edit(~/go/pkg/mod/**)",
            "Edit(**/*.pb.go)",
            "Edit(**/*.pb.gw.go)",
            "Edit(**/*.pb.cc)",
            "Edit(**/*.pb.h)",
            "Edit(**/*.pb.rs)",
            "Edit(**/*.pb.swift)",
            "Edit(**/*_pb2.py)",
            "Edit(**/*_pb2_grpc.py)",
            "Edit(**/*_pb2.pyi)",
            "Edit(**/*_pb.js)",
            "Edit(**/*_pb.d.ts)",
            "Edit(**/*.gen.go)",
            "Edit(**/*_generated.go)",
            "Edit(**/zz_generated*.go)",
            "Edit(**/wire_gen.go)",
            "Edit(**/*.g.dart)",
            "Edit(**/*.freezed.dart)",
            "Edit(**/*.g.cs)",
            "Edit(**/*.designer.cs)",
            "Edit(**/*.Designer.cs)",
            "Edit(**/*.min.js)",
            "Edit(**/*.min.css)",
            "Edit(**/*.js.map)",
            "Edit(**/*.css.map)",
            "Edit(**/*.pyc)",
            "Edit(**/*.pyo)",
            "Edit(**/*.pyd)",
            "Edit(**/__pycache__/**)",
            "Edit(**/*.egg-info/**)",
            "Edit(**/*.class)",
            "Edit(**/*.jar)",
            "Edit(**/*.war)",
            "Edit(**/*.ear)",
            "Edit(**/*.dex)",
            "Edit(**/*.beam)",
            "Edit(**/*.o)",
            "Edit(**/*.obj)",
            "Edit(**/*.a)",
            "Edit(**/*.lib)",
            "Edit(**/*.so)",
            "Edit(**/*.dylib)",
            "Edit(**/*.dll)",
            "Edit(**/*.exe)",
            "Edit(**/*.pdb)",
            "Edit(**/*.wasm)"
        ],
        "ask": [
            "Read(~/.zshrc)",
            "Read(~/.zshprofile)",
            "Read(~/.bashrc)",
            "Read(~/.bashprofile)",
            "Read(~/.profile)",
            "Bash(gh release:*)",
            "Bash(gh pr merge:*)",
            "Bash(glab mr merge:*)",
            "Bash(npm publish:*)",
            "Bash(yarn publish:*)",
            "Bash(pnpm publish:*)",
            "Bash(cargo publish:*)",
            "Bash(docker push:*)",
            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Bash(git push origin --delete:*)",
            "Bash(git reset:*)",
            "Bash(git checkout:*)",
            "Bash(mysql:*)",
            "Bash(mariadb:*)",
            "Bash(mysqldump:*)",
            "Bash(redis-cli:*)",
            "Bash(mongosh:*)",
            "Bash(mongo:*)",
            "Bash(mongodump:*)",
            "Bash(psql:*)",
            "Bash(pg_dump:*)",
            "Bash(pg_restore:*)",
            "Bash(sqlite3:*)"
        ]
    },
    "env": {
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
        "DO_NOT_TRACK": "1",
        "CLAUDE_CODE_MCP_ALLOWLIST_ENV": "1",
        "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
        "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
        "CLAUDE_CODE_SUPPRESS_SESSION_ATTRIBUTION": "1"
    }
}
