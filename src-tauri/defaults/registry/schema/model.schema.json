{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "model.schema.json",
  "title": "model entry",
  "description": "platforms/<code>/models/<model>.json。同一模型每平台一条独立条目，靠 canonical_model 跨平台聚合。主键 platform_code + model_id（DB 表 model_entry，ADR 0005）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "canonical_model",
    "capabilities",
    "official",
    "input_cost_per_token"
  ],
  "properties": {
    "model_id": {
      "type": "string",
      "minLength": 1,
      "description": "平台真实请求名，须与文件名（去 .json）一致，@ / : 等特殊字符原样保留。"
    },
    "canonical_model": {
      "type": "string",
      "minLength": 1,
      "description": "跨平台聚合键。写入层缺省回落 model_id（model_entry.rs），schema 层必填。"
    },
    "display_name": {
      "type": "string",
      "description": "展示名（单字符串不译）。缺省 / 空串 / 纯空白由读取层回落 model_id（票 T10）。"
    },
    "family": {
      "type": "string",
      "description": "模型家族（如 claude / glm）。"
    },
    "version": {
      "type": "string",
      "description": "版本号字符串。"
    },
    "predecessor": {
      "type": "string",
      "description": "上一代模型 id，用于 UI 前后代链。"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "text",
          "vision",
          "image_gen",
          "audio",
          "embedding"
        ]
      }
    },
    "builtin_tools_excluded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "该模型不支持的内置工具名单。"
    },
    "max_input_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "context_window": {
      "type": "integer",
      "minimum": 1
    },
    "official": {
      "type": "boolean",
      "description": "是否官方渠道条目。不变量：每个 model_id 至少有一个平台条目 official=true（test_registry.rs 锁定）。"
    },
    "input_cost_per_token": {
      "type": "number",
      "minimum": 0
    },
    "output_cost_per_token": {
      "type": "number",
      "minimum": 0
    },
    "cache_read_input_token_cost": {
      "type": "number",
      "minimum": 0
    },
    "cache_creation_input_token_cost": {
      "type": "number",
      "minimum": 0
    },
    "default_price": {
      "$ref": "#/definitions/priceObject",
      "description": "非官方渠道条目的兜底单价对象（vendor 中转站常无官方价）。"
    },
    "peak": {
      "$ref": "#/definitions/priceObject",
      "description": "高峰时段绝对价（price_resolve.rs：命中 peak_hours 窗口且条目带 peak → 用绝对价，平台倍率压成 1.0，不得再乘，否则双重计价）。"
    },
    "context_tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "min_tokens",
          "input_cost_per_token",
          "output_cost_per_token"
        ],
        "properties": {
          "min_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "input_cost_per_token": {
            "type": "number",
            "minimum": 0
          },
          "output_cost_per_token": {
            "type": "number",
            "minimum": 0
          },
          "cache_read_input_token_cost": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "description": "按上下文长度分档计价（如 >524288 tokens 档）。"
    },
    "time_tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_at",
          "input_cost_per_token",
          "output_cost_per_token"
        ],
        "properties": {
          "start_at": {
            "type": "integer",
            "minimum": 0
          },
          "input_cost_per_token": {
            "type": "number",
            "minimum": 0
          },
          "output_cost_per_token": {
            "type": "number",
            "minimum": 0
          },
          "cache_read_input_token_cost": {
            "type": "number",
            "minimum": 0
          },
          "context_tiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/contextTier"
            }
          }
        }
      },
      "description": "按生效时间切换的价目（start_at Unix 秒，latest wins）。"
    }
  },
  "definitions": {
    "priceObject": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "input_cost_per_token": {
          "type": "number",
          "minimum": 0
        },
        "output_cost_per_token": {
          "type": "number",
          "minimum": 0
        },
        "cache_read_input_token_cost": {
          "type": "number",
          "minimum": 0
        },
        "cache_creation_input_token_cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "contextTier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_tokens",
        "input_cost_per_token",
        "output_cost_per_token"
      ],
      "properties": {
        "min_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "input_cost_per_token": {
          "type": "number",
          "minimum": 0
        },
        "output_cost_per_token": {
          "type": "number",
          "minimum": 0
        },
        "cache_read_input_token_cost": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
