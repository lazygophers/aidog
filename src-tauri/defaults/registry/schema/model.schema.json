{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "model.schema.json",
  "title": "model entry",
  "description": "platforms/<code>/models/<model>.json。同一模型每平台一条独立条目，靠 canonical_model 跨平台聚合。主键 platform_code + model_id（DB 表 model_entry，ADR 0005）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "last_updated",
    "model_id",
    "canonical_model",
    "capabilities",
    "official",
    "price"
  ],
  "definitions": {
    "unit_price": {
      "type": "number",
      "minimum": 0,
      "description": "单价（$/token）。计价一律数值字段，禁字符串表达式。"
    },
    "tier_prices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "type": "number",
          "minimum": 0,
          "description": "【必填】本档输入单价（$/token）。"
        },
        "output": {
          "type": "number",
          "minimum": 0,
          "description": "【必填】本档输出单价（$/token）。"
        },
        "cache_read": {
          "type": "number",
          "minimum": 0,
          "description": "【可选】本档缓存读单价（$/token）。"
        }
      }
    },
    "context_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_tokens",
        "input",
        "output"
      ],
      "properties": {
        "min_tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "【必填】档位门槛：请求数达到该 token 数起用本档价。"
        },
        "input": {
          "type": "number",
          "minimum": 0,
          "description": "【必填】本档输入单价（$/token）。"
        },
        "output": {
          "type": "number",
          "minimum": 0,
          "description": "【必填】本档输出单价（$/token）。"
        },
        "cache_read": {
          "type": "number",
          "minimum": 0,
          "description": "【可选】本档缓存读单价（$/token）。"
        }
      }
    },
    "context_tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/context_tier"
      },
      "description": "按上下文长度分档计价（数值结构化，禁表达式）。"
    }
  },
  "properties": {
    "last_updated": {
      "type": "integer",
      "minimum": 0,
      "description": "【必填】内容变更时间 Unix 秒。改完内容必须跑 scripts/bump-registry-last-updated.mjs 重新盖戳，不盖则远程同步按内容比对永远跳过该文件。"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "description": "【必填】平台真实请求名，须与文件名（去 .json）一致，@ / : 等特殊字符原样保留。"
    },
    "canonical_model": {
      "type": "string",
      "minLength": 1,
      "description": "【必填】跨平台聚合键。写入层缺省回落 model_id（model_entry.rs），schema 层必填。"
    },
    "display_name": {
      "type": "string",
      "description": "【可选】展示名（单字符串不译）。缺省 / 空串 / 纯空白由读取层回落 model_id（票 T10）。"
    },
    "family": {
      "type": "string",
      "description": "【可选】模型家族（如 claude / glm）。"
    },
    "version": {
      "type": "string",
      "description": "【可选】版本号字符串。"
    },
    "predecessor": {
      "type": "string",
      "description": "【可选】上一代模型 id，用于 UI 前后代链。"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "text",
          "vision",
          "tool_use",
          "reasoning",
          "text_to_image",
          "image_to_image",
          "image_edit",
          "text_to_video",
          "image_to_video",
          "video_to_video",
          "video_edit",
          "audio",
          "video",
          "embedding",
          "rerank"
        ]
      },
      "description": "【必填】能力标签枚举（text 必含；vision / tool_use / reasoning 理解类，text_to_image / image_to_image / image_edit / text_to_video / image_to_video / video_to_video / video_edit 生成类按需，audio / video / embedding / rerank 按需）。"
    },
    "builtin_tools_excluded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "【可选】该模型不支持的内置工具名单。"
    },
    "max_input_tokens": {
      "type": "integer",
      "minimum": 1,
      "description": "【可选】最大输入 token 数。"
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1,
      "description": "【可选】最大输出 token 数。"
    },
    "context_window": {
      "type": "integer",
      "minimum": 1,
      "description": "【可选】上下文窗口总 token 数。"
    },
    "official": {
      "type": "boolean",
      "description": "【必填】是否官方渠道条目。不变量：每个 model_id 至少有一个平台条目 official=true（test_registry.rs 锁定）。"
    },
    "thinking_supported": {
      "type": "boolean",
      "description": "【可选】该模型是否支持 thinking/推理模式（扩展思考输出）。缺省=未标注，消费方视为未知。"
    },
    "thinking_toggleable": {
      "type": "boolean",
      "description": "【可选】thinking 是否可由请求参数开关（如 qwen3 enable_thinking、claude thinking.budget_tokens）。false=强制思考（deepseek-r1 型）。缺省=未标注。"
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input"
      ],
      "properties": {
        "input": {
          "type": "number",
          "minimum": 0,
          "description": "【必填】输入单价（$/token；非流式基础价）。"
        },
        "output": {
          "type": "number",
          "minimum": 0,
          "description": "【可选】输出单价（$/token）。"
        },
        "cache_read": {
          "type": "number",
          "minimum": 0,
          "description": "【可选】缓存读单价（$/token）。"
        },
        "cache_write": {
          "type": "number",
          "minimum": 0,
          "description": "【可选】缓存写单价（$/token）。"
        },
        "peak": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "input": {
              "type": "number",
              "minimum": 0,
              "description": "【可选】高峰输入单价（$/token）。"
            },
            "output": {
              "type": "number",
              "minimum": 0,
              "description": "【可选】高峰输出单价（$/token）。"
            },
            "cache_read": {
              "type": "number",
              "minimum": 0,
              "description": "【可选】高峰缓存读单价（$/token）。"
            }
          },
          "description": "【可选】高峰时段绝对价（price_resolve.rs：命中平台 peak 窗口且条目带 peak → 用绝对价，平台倍率压成 1.0，不得再乘，否则双重计价）。未写字段继承默认价。"
        },
        "context_tiers": {
          "$ref": "#/definitions/context_tiers",
          "description": "【可选】按上下文长度分档计价（如 >524288 tokens 档）。"
        },
        "time_tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_at",
              "input",
              "output"
            ],
            "properties": {
              "start_at": {
                "type": "integer",
                "minimum": 0,
                "description": "【必填】本档生效起点（Unix 秒，latest wins）。"
              },
              "input": {
                "type": "number",
                "minimum": 0,
                "description": "【必填】本档输入单价（$/token）。"
              },
              "output": {
                "type": "number",
                "minimum": 0,
                "description": "【必填】本档输出单价（$/token）。"
              },
              "cache_read": {
                "type": "number",
                "minimum": 0,
                "description": "【可选】本档缓存读单价（$/token）。"
              },
              "context_tiers": {
                "$ref": "#/definitions/context_tiers",
                "description": "【可选】本时段档内再按上下文长度分档（形状同顶层 context_tiers）。"
              }
            }
          },
          "description": "【可选】按生效时间切换的价目（start_at Unix 秒，latest wins）。"
        }
      },
      "description": "【必填】计价结构：默认单价 + 高峰绝对价 + 分档价，全部数值字段（$/token），禁字符串表达式。旧顶层价格字段（input_cost_per_token 等 + default_price）2026-08-30 已收归于此。"
    }
  },
  "last_updated": 1788012963,
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "text"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "required": [
          "max_input_tokens",
          "max_output_tokens",
          "context_window"
        ]
      }
    }
  ]
}
