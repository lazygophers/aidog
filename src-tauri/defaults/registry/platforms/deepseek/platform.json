      "script": "function httpErr(e) {\n  var m = e && e.message ? String(e.message) : String(e);\n  if (m.indexOf(\"HTTP \") === 0) return m;\n  if (m.indexOf(\"JSON parse: \") === 0) return \"Parse: \" + m.slice(12);\n  return \"Network: \" + m;\n}\nfunction num(v) {\n  if (typeof v === \"number\") return v;\n  if (typeof v === \"string\" && v.trim() !== \"\" && !isNaN(Number(v))) return Number(v);\n  return 0.0;\n}\nvar body;\ntry {\n  body = http.get(\"https://api.deepseek.com/user/balance\", { Authorization: \"Bearer \" + ctx.apiKey });\n} catch (e) {\n  return { success: false, error: httpErr(e) };\n}\nif (body == null) body = {};\nvar remaining = 0.0;\nvar infos = body.balance_infos;\nif (Array.isArray(infos)) {\n  for (var i = 0; i < infos.length; i++) {\n    var info = infos[i];\n    if (info) remaining += num(info.total_balance);\n  }\n}\nreturn {\n  success: true,\n  error: null,\n  balance: {\n    remaining: remaining,\n    total: null,\n    used: null,\n    currency: \"CNY\",\n    is_valid: body.is_available !== false\n  },\n  coding_plan: null\n};"
    }
