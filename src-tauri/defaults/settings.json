{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "language": "zh-Hans",
    "autoCompactEnabled": true,
    "autoConnectIde": true,
    "autoMemoryEnabled": true,
    "autoScrollEnabled": true,
    "cleanupPeriodDays": 30,
    "disableClaudeAiConnectors": true,
    "effortLevel": "medium",
    "emojiCompletionEnabled": false,
    "preferredNotifChannel": "terminal_bell",
    "prefersReducedMotion": true,
    "showThinkingSummaries": true,
    "showTurnDuration": true,
    "skipDangerousModePermissionPrompt": true,
    "spinnerTipsEnabled": true,
    "teammateMode": "in-process",
    "terminalProgressBarEnabled": true,
    "tui": "fullscreen",
    "verbose": true,
    "viewMode": "verbose",
    "alwaysThinkingEnabled": true,
    "fastMode": false,
    "skillListingMaxDescChars": 1024,
    "feedbackSurveyRate": 0,
    "includeCoAuthoredBy": false,
    "isolatePeerMachines": true,
    "_aidog_statusline": {
        "enabled": true
    },
    "_aidog_subagent_statusline": {
        "enabled": true
    },
    "_aidog_hooks": {
        "enabled": true
    },
    "attribution": {
        "commit": "",
        "pr": ""
    },

    "enabledPlugins": {
        "caveman@caveman": true,
        "i-have-adhd@i-have-adhd": true,
        "ponytail@ponytail": true
    },
    "permissions": {
        "defaultMode": "bypassPermissions",
        "deny": [
            "Artifact",
            "Monitor",
            "NotebookEdit",
            "PushNotification",
            "Read(**/.env)",
            "Read(**/.env.*)",
            "Read(**/.env.local)",
            "Read(**/*.key)",
            "Read(**/*.pem)",
            "Read(**/*.p12)",
            "Read(**/*.pfx)",
            "Read(**/credentials.json)",
            "Read(**/service-account*.json)",
            "Read(**/.htpasswd)",
            "Read(**/id_rsa)",
            "Read(**/id_ed25519)",
            "Read(**/id_ecdsa)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.config/gcloud/**)",
            "Read(~/.kube/config)",
            "Read(~/.claude/.credentials.json)",
            "Read(**/.git-credentials)",
            "Read(**/.netrc)",
            "Read(**/.npmrc)",
            "Read(**/.pgpass)",
            "Read(**/*.kdbx)",
            "Edit(**/go.sum)",
            "Edit(**/yarn.lock)",
            "Edit(**/package-lock.json)",
            "Edit(**/pnpm-lock.yaml)",
            "Edit(**/Cargo.lock)",
            "Edit(**/composer.lock)",
            "Edit(**/Podfile.lock)",
            "Edit(**/poetry.lock)",
            "Edit(**/uv.lock)",
            "Edit(**/bun.lockb)",
            "Edit(**/bun.lock)",
            "Edit(**/deno.lock)",
            "Edit(**/flake.lock)",
            "Edit(**/gradle.lockfile)",
            "Edit(**/packages.lock.json)",
            "Edit(**/mix.lock)",
            "Edit(**/.terraform.lock.hcl)",
            "Edit(**/node_modules/**)",
            "Edit(**/vendor/**)",
            "Edit(**/bower_components/**)",
            "Edit(**/.yarn/**)",
            "Edit(**/.pnpm-store/**)",
            "Edit(**/.venv/**)",
            "Edit(**/site-packages/**)",
            "Edit(**/Pods/**)",
            "Edit(~/.cargo/registry/**)",
            "Edit(~/go/pkg/mod/**)",
            "Edit(**/*.pb.go)",
            "Edit(**/*.pb.gw.go)",
            "Edit(**/*.pb.cc)",
            "Edit(**/*.pb.h)",
            "Edit(**/*.pb.rs)",
            "Edit(**/*.pb.swift)",
            "Edit(**/*_pb2.py)",
            "Edit(**/*_pb2_grpc.py)",
            "Edit(**/*_pb2.pyi)",
            "Edit(**/*_pb.js)",
            "Edit(**/*_pb.d.ts)",
            "Edit(**/*.gen.go)",
            "Edit(**/*_generated.go)",
            "Edit(**/zz_generated*.go)",
            "Edit(**/wire_gen.go)",
            "Edit(**/*.g.dart)",
            "Edit(**/*.freezed.dart)",
            "Edit(**/*.g.cs)",
            "Edit(**/*.designer.cs)",
            "Edit(**/*.Designer.cs)",
            "Edit(**/*.min.js)",
            "Edit(**/*.min.css)",
            "Edit(**/*.js.map)",
            "Edit(**/*.css.map)",
            "Edit(**/*.pyc)",
            "Edit(**/*.pyo)",
            "Edit(**/*.pyd)",
            "Edit(**/__pycache__/**)",
            "Edit(**/*.egg-info/**)",
            "Edit(**/*.class)",
            "Edit(**/*.jar)",
            "Edit(**/*.war)",
            "Edit(**/*.ear)",
            "Edit(**/*.dex)",
            "Edit(**/*.beam)",
            "Edit(**/*.o)",
            "Edit(**/*.obj)",
            "Edit(**/*.a)",
            "Edit(**/*.lib)",
            "Edit(**/*.so)",
            "Edit(**/*.dylib)",
            "Edit(**/*.dll)",
            "Edit(**/*.exe)",
            "Edit(**/*.pdb)",
            "Edit(**/*.wasm)"
        ],
        "ask": [
            "Edit(**/go.mod)",
            "Edit(**/package.json)",
            "Edit(**/Cargo.toml)",
            "Edit(**/Gemfile)",
            "Edit(**/pyproject.toml)",
            "Edit(**/requirements.txt)",
            "Edit(**/Pipfile)",
            "Edit(**/deno.json)",
            "Edit(**/bunfig.toml)",
            "Edit(**/composer.json)",
            "Edit(**/Podfile)",
            "Edit(**/mix.exs)",
            "Edit(**/flake.nix)",
            "Edit(**/CMakeLists.txt)",
            "Edit(**/Chart.yaml)",
            "Edit(**/*.csproj)",
            "Edit(**/*.fsproj)",
            "Edit(**/*.vcxproj)",
            "Edit(**/*.sln)",
            "Edit(**/pom.xml)",
            "Edit(**/build.gradle)",
            "Edit(**/*.gradle.kts)",
            "Edit(**/settings.gradle)",
            "Edit(**/settings.gradle.kts)",
            "Edit(**/gradle.properties)",
            "Edit(**/pnpm-workspace.yaml)",
            "Edit(**/lerna.json)",
            "Edit(**/turbo.json)",
            "Edit(**/nx.json)",
            "Edit(**/generated/**)",
            "Edit(**/__generated__/**)",
            "Edit(**/gen/**)",
            "Edit(**/autogen/**)",
            "Edit(**/*.generated.*)",
            "Edit(**/dist/**)",
            "Edit(**/build/**)",
            "Edit(**/out/**)",
            "Edit(**/target/**)",
            "Edit(**/mocks/**)",
            "Edit(**/mock_*.go)",
            "Edit(**/*_mock.go)",
            "Edit(**/*.mock.ts)",
            "Edit(**/migrations/**)",
            "Edit(**/*.snap)",
            "Edit(**/*.d.ts)"
        ]
    },
    "env": {
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "3",
        "CLAUDE_CODE_FORK_SUBAGENT": "1",
        "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "1000",
        "CLAUDE_CODE_HIDE_CWD": "1",
        "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "1",
        "CLAUDE_CODE_PLUGIN_PREFER_HTTPS": "1",
        "BASH_MAX_OUTPUT_LENGTH": "10240",
        "CLAUDE_CODE_DISABLE_BG_EXIT_HANDOFF": "1",
        "CLAUDE_CODE_DISABLE_CRON": "1",
        "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
        "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
        "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
        "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
        "NO_PROXY": "localhost,127.0.0.1,192.168.0.0/16,10.0.0.0/8,*.cn",
        "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "10240",
        "FORCE_AUTOUPDATE_PLUGINS": "1",
        "DO_NOT_TRACK": "1",
        "CLAUDE_CODE_EFFORT_LEVEL": "medium",
        "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
        "ENABLE_TOOL_SEARCH": "true",
        "ENABLE_PROMPT_CACHING_1H": "1",
        "CLAUDE_CODE_MCP_ALLOWLIST_ENV": "1",
        "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1"
    },
    "extraKnownMarketplaces": {
        "caveman": {
            "source": {
                "repo": "JuliusBrussee/caveman",
                "source": "github"
            },
            "autoUpdate": true
        },
        "ccplugin-market": {
            "source": {
                "repo": "lazygophers/ccplugin",
                "source": "github"
            },
            "autoUpdate": true
        },
        "claude-code-warp": {
            "source": {
                "repo": "warpdotdev/claude-code-warp",
                "source": "github"
            },
            "autoUpdate": true
        },
        "i-have-adhd": {
            "source": {
                "repo": "ayghri/i-have-adhd",
                "source": "github"
            },
            "autoUpdate": true
        },
        "ponytail": {
            "source": {
                "repo": "DietrichGebert/ponytail",
                "source": "github"
            },
            "autoUpdate": true
        }
    }
}
