{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "zh-Hans",
  "autoConnectIde": true,
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": true,
  "cleanupPeriodDays": 30,
  "prefersReducedMotion": true,
  "skipDangerousModePermissionPrompt": true,
  "showThinkingSummaries": true,
  "showTurnDuration": true,
  "autoScrollEnabled": true,
  "spinnerTipsEnabled": true,
  "terminalProgressBarEnabled": true,
  "feedbackSurveyRate": 0,
  "teammateMode": "in-process",
  "includeCoAuthoredBy": false,
  "disableClaudeAiConnectors": true,
  "isolatePeerMachines": true,
  "_aidog_statusline": { "enabled": true },
  "_aidog_subagent_statusline": { "enabled": true },
  "_aidog_hooks": { "enabled": true },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.env.local)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/.htpasswd)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.git-credentials)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pgpass)",
      "Read(**/*.kdbx)",
      "Write(**/go.sum)",
      "Edit(**/go.sum)",
      "Write(**/yarn.lock)",
      "Edit(**/yarn.lock)",
      "Write(**/package-lock.json)",
      "Edit(**/package-lock.json)",
      "Write(**/pnpm-lock.yaml)",
      "Edit(**/pnpm-lock.yaml)",
      "Write(**/Cargo.lock)",
      "Edit(**/Cargo.lock)",
      "Write(**/composer.lock)",
      "Edit(**/composer.lock)",
      "Write(**/Podfile.lock)",
      "Edit(**/Podfile.lock)",
      "Write(**/poetry.lock)",
      "Edit(**/poetry.lock)",
      "Write(**/uv.lock)",
      "Edit(**/uv.lock)",
      "Write(**/bun.lockb)",
      "Edit(**/bun.lockb)",
      "Write(**/bun.lock)",
      "Edit(**/bun.lock)",
      "Write(**/deno.lock)",
      "Edit(**/deno.lock)",
      "Write(**/flake.lock)",
      "Edit(**/flake.lock)",
      "Write(**/gradle.lockfile)",
      "Edit(**/gradle.lockfile)",
      "Write(**/packages.lock.json)",
      "Edit(**/packages.lock.json)",
      "Write(**/mix.lock)",
      "Edit(**/mix.lock)",
      "Write(**/.terraform.lock.hcl)",
      "Edit(**/.terraform.lock.hcl)",
      "Edit(**/node_modules/**)",
      "Write(**/node_modules/**)",
      "Edit(**/vendor/**)",
      "Write(**/vendor/**)",
      "Edit(**/bower_components/**)",
      "Write(**/bower_components/**)",
      "Edit(**/.yarn/**)",
      "Write(**/.yarn/**)",
      "Edit(**/.pnpm-store/**)",
      "Write(**/.pnpm-store/**)",
      "Edit(**/.venv/**)",
      "Write(**/.venv/**)",
      "Edit(**/site-packages/**)",
      "Write(**/site-packages/**)",
      "Edit(**/Pods/**)",
      "Write(**/Pods/**)",
      "Edit(~/.cargo/registry/**)",
      "Write(~/.cargo/registry/**)",
      "Edit(~/go/pkg/mod/**)",
      "Write(~/go/pkg/mod/**)"
    ],
    "ask": [
      "Write(**/go.mod)",
      "Edit(**/go.mod)",
      "Write(**/package.json)",
      "Edit(**/package.json)",
      "Write(**/Cargo.toml)",
      "Edit(**/Cargo.toml)",
      "Write(**/Gemfile)",
      "Edit(**/Gemfile)",
      "Write(**/pyproject.toml)",
      "Edit(**/pyproject.toml)",
      "Write(**/requirements.txt)",
      "Edit(**/requirements.txt)",
      "Write(**/Pipfile)",
      "Edit(**/Pipfile)",
      "Write(**/deno.json)",
      "Edit(**/deno.json)",
      "Write(**/bunfig.toml)",
      "Edit(**/bunfig.toml)",
      "Write(**/composer.json)",
      "Edit(**/composer.json)",
      "Write(**/Podfile)",
      "Edit(**/Podfile)",
      "Write(**/mix.exs)",
      "Edit(**/mix.exs)",
      "Write(**/flake.nix)",
      "Write(**/CMakeLists.txt)",
      "Write(**/Makefile)",
      "Write(**/Dockerfile)",
      "Write(**/Chart.yaml)",
      "Write(**/*.csproj)",
      "Write(**/*.fsproj)",
      "Write(**/*.vcxproj)",
      "Write(**/*.sln)",
      "Write(**/pom.xml)",
      "Write(**/build.gradle)",
      "Write(**/*.gradle.kts)",
      "Write(**/settings.gradle)",
      "Write(**/settings.gradle.kts)",
      "Write(**/gradle.properties)",
      "Write(**/pnpm-workspace.yaml)",
      "Write(**/lerna.json)",
      "Write(**/turbo.json)",
      "Write(**/nx.json)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "3",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "1000",
    "CLAUDE_CODE_HIDE_CWD": "1",
    "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "1",
    "CLAUDE_CODE_PLUGIN_PREFER_HTTPS": "1",
    "BASH_MAX_OUTPUT_LENGTH": "10240",
    "CLAUDE_CODE_DISABLE_BG_EXIT_HANDOFF": "1",
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "NO_PROXY": "localhost,127.0.0.1,192.168.0.0/16,10.0.0.0/8,*.cn",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "10240",
    "FORCE_AUTOUPDATE_PLUGINS": "1",
    "DO_NOT_TRACK": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "medium",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "CLAUDE_CODE_MCP_ALLOWLIST_ENV": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1"
  },
  "extraKnownMarketplaces": {
    "ccplugin-market": {
      "source": {
        "repo": "lazygophers/ccplugin",
        "source": "github"
      },
      "autoUpdate": true
    },
    "claude-code-warp": {
      "source": {
        "repo": "warpdotdev/claude-code-warp",
        "source": "github"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "code-modernization@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false
  }
}
