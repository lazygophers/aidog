{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "zh-Hans",
  "autoConnectIde": true,
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": true,
  "cleanupPeriodDays": 30,
  "prefersReducedMotion": true,
  "skipDangerousModePermissionPrompt": true,
  "showThinkingSummaries": true,
  "showTurnDuration": true,
  "autoScrollEnabled": true,
  "spinnerTipsEnabled": true,
  "terminalProgressBarEnabled": true,
  "feedbackSurveyRate": 0,
  "teammateMode": "in-process",
  "includeCoAuthoredBy": false,
  "_aidog_statusline": { "enabled": true },
  "_aidog_subagent_statusline": { "enabled": true },
  "_aidog_hooks": { "enabled": true },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Write(go.sum)",
      "Write(yarn.lock)",
      "Write(package-lock.json)",
      "Write(pnpm-lock.yaml)",
      "Write(Cargo.lock)",
      "Write(composer.lock)",
      "Write(Podfile.lock)",
      "Write(poetry.lock)",
      "Write(uv.lock)",
      "Write(bun.lockb)",
      "Write(deno.lock)",
      "Write(flake.lock)",
      "Write(gradle.lockfile)",
      "Write(packages.lock.json)",
      "Write(mix.lock)",
      "Write(.terraform.lock.hcl)"
    ],
    "ask": [
      "Write(go.mod)",
      "Write(package.json)",
      "Write(Cargo.toml)",
      "Write(Gemfile)",
      "Write(pyproject.toml)",
      "Write(requirements.txt)",
      "Write(Pipfile)",
      "Write(deno.json)",
      "Write(bunfig.toml)",
      "Write(composer.json)",
      "Write(Podfile)",
      "Write(mix.exs)",
      "Write(flake.nix)",
      "Write(CMakeLists.txt)",
      "Write(Makefile)",
      "Write(Dockerfile)",
      "Write(Chart.yaml)",
      "Write(*.csproj)",
      "Write(*.fsproj)",
      "Write(*.vcxproj)",
      "Write(*.sln)",
      "Write(pom.xml)",
      "Write(build.gradle)",
      "Write(*.gradle.kts)",
      "Write(settings.gradle)",
      "Write(settings.gradle.kts)",
      "Write(gradle.properties)",
      "Write(pnpm-workspace.yaml)",
      "Write(lerna.json)",
      "Write(turbo.json)",
      "Write(nx.json)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "3",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "1000",
    "CLAUDE_CODE_HIDE_CWD": "1",
    "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "1",
    "CLAUDE_CODE_PLUGIN_PREFER_HTTPS": "1",
    "BASH_MAX_OUTPUT_LENGTH": "10240",
    "CLAUDE_CODE_DISABLE_BG_EXIT_HANDOFF": "1",
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "NO_PROXY": "localhost,127.0.0.1,192.168.0.0/16,10.0.0.0/8,*.cn",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "10240",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "180000",
    "CLAUDE_CODE_PLAN_MODE_REQUIRED": "true",
    "FORCE_AUTOUPDATE_PLUGINS": "1",
    "DO_NOT_TRACK": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "medium",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "extraKnownMarketplaces": {
    "ccplugin-market": {
      "source": {
        "repo": "lazygophers/ccplugin",
        "source": "github"
      },
      "skipLfs": true,
      "autoUpdate": true
    },
    "claude-code-warp": {
      "source": {
        "repo": "warpdotdev/claude-code-warp",
        "source": "github"
      },
      "skipLfs": true,
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      },
      "skipLfs": true,
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-modernization@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "warp@claude-code-warp": true,
    "trellisx@ccplugin-market": true,
    "git@ccplugin-market": true
  }
}
