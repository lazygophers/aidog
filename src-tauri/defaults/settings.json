{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "language": "zh-Hans",
    "autoCompactEnabled": true,
    "autoConnectIde": true,
    "autoMemoryEnabled": true,
    "autoScrollEnabled": true,
    "cleanupPeriodDays": 30,
    "disableClaudeAiConnectors": true,
    "effortLevel": "medium",
    "emojiCompletionEnabled": false,
    "preferredNotifChannel": "terminal_bell",
    "prefersReducedMotion": true,
    "showThinkingSummaries": true,
    "showTurnDuration": true,
    "autoUpdatesChannel": "latest",
    "skipDangerousModePermissionPrompt": true,
    "spinnerTipsEnabled": true,
    "teammateMode": "in-process",
    "terminalProgressBarEnabled": true,
    "tui": "fullscreen",
    "awaySummaryEnabled": true,
    "verbose": true,
    "viewMode": "verbose",
    "axScreenReader": false,
    "alwaysThinkingEnabled": true,
    "fastMode": false,
    "skillListingMaxDescChars": 1024,
    "feedbackSurveyRate": 0,
    "includeCoAuthoredBy": false,
    "isolatePeerMachines": true,
    "agentPushNotifEnabled": false,
    "disableArtifact": true,
    "disableRemoteControl": true,
    "advisorModel": "opus",
    "askUserQuestionTimeout": "never",
    "companyAnnouncements": [
        "删繁就简三秋树，领异标新二月花",
        "操千曲而后晓声，观千剑而后识器",
        "千淘万漉虽辛苦，吹尽狂沙始到金",
        "行到水穷处，坐看云起时",
        "醉后不知天在水，满船清梦压星河",
        "掬水月在手，弄花香满衣",
        "山静似太古，日长如小年",
        "细雨湿衣看不见，闲花落地听无声",
        "人间有味是清欢",
        "殷勤昨夜三更雨，又得浮生一日凉",
        "小舟从此逝，江海寄余生",
        "休对故人思故国，且将新火试新茶",
        "自在飞花轻似梦，无边丝雨细如愁",
        "雾失楼台，月迷津渡",
        "落花人独立，微雨燕双飞",
        "叶上初阳干宿雨，水面清圆，一一风荷举",
        "流光容易把人抛，红了樱桃，绿了芭蕉",
        "春水碧于天，画船听雨眠",
        "惆怅东栏一株雪，人生看得几清明",
        "苔花如米小，也学牡丹开",
        "我有一瓢酒，可以慰风尘",
        "向来枉费推移力，此日中流自在行",
        "万物静观皆自得，四时佳兴与人同",
        "城中桃李愁风雨，春在溪头荠菜花",
        "因过竹院逢僧话，偷得浮生半日闲",
        "我见青山多妩媚，料青山见我应如是"
    ],
    "autoMode": {
      "classifyAllShell": false,
      "environment": [
            "$defaults"
          ],
          "allow": [
            "$defaults"
          ],
          "soft_deny": [
            "$defaults"
          ],
          "hard_deny": [
            "$defaults"
          ]
    },
    "_aidog_statusline": {
        "enabled": true
    },
    "_aidog_hooks": {
        "enabled": true
    },
    "attribution": {
        "commit": "",
        "pr": ""
    },
    "enabledPlugins": {
        "caveman@caveman": true,
        "i-have-adhd@i-have-adhd": true,
        "ponytail@ponytail": true
    },
    "permissions": {
        "defaultMode": "bypassPermissions",
        "deny": [
            "Artifact",
            "Monitor",
            "NotebookEdit",
            "Read(**/.env)",
            "Read(**/.env.*)",
            "Read(**/.env.local)",
            "Read(**/*.key)",
            "Read(**/*.pem)",
            "Read(**/*.p12)",
            "Read(**/*.pfx)",
            "Read(**/credentials.json)",
            "Read(**/service-account*.json)",
            "Read(**/.htpasswd)",
            "Read(**/id_rsa)",
            "Read(**/id_ed25519)",
            "Read(**/id_ecdsa)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.config/gcloud/**)",
            "Read(~/.kube/config)",
            "Read(~/.claude/.credentials.json)",
            "Read(**/.git-credentials)",
            "Read(**/.netrc)",
            "Read(**/.npmrc)",
            "Read(**/.pgpass)",
            "Read(**/*.kdbx)",
            "Edit(**/go.sum)",
            "Edit(**/yarn.lock)",
            "Edit(**/package-lock.json)",
            "Edit(**/pnpm-lock.yaml)",
            "Edit(**/Cargo.lock)",
            "Edit(**/composer.lock)",
            "Edit(**/Podfile.lock)",
            "Edit(**/poetry.lock)",
            "Edit(**/uv.lock)",
            "Edit(**/bun.lockb)",
            "Edit(**/bun.lock)",
            "Edit(**/deno.lock)",
            "Edit(**/flake.lock)",
            "Edit(**/gradle.lockfile)",
            "Edit(**/packages.lock.json)",
            "Edit(**/mix.lock)",
            "Edit(**/.terraform.lock.hcl)",
            "Edit(**/node_modules/**)",
            "Edit(**/vendor/**)",
            "Edit(**/bower_components/**)",
            "Edit(**/.yarn/**)",
            "Edit(**/.pnpm-store/**)",
            "Edit(**/.venv/**)",
            "Edit(**/site-packages/**)",
            "Edit(**/Pods/**)",
            "Edit(~/.cargo/registry/**)",
            "Edit(~/go/pkg/mod/**)",
            "Edit(**/*.pb.go)",
            "Edit(**/*.pb.gw.go)",
            "Edit(**/*.pb.cc)",
            "Edit(**/*.pb.h)",
            "Edit(**/*.pb.rs)",
            "Edit(**/*.pb.swift)",
            "Edit(**/*_pb2.py)",
            "Edit(**/*_pb2_grpc.py)",
            "Edit(**/*_pb2.pyi)",
            "Edit(**/*_pb.js)",
            "Edit(**/*_pb.d.ts)",
            "Edit(**/*.gen.go)",
            "Edit(**/*_generated.go)",
            "Edit(**/zz_generated*.go)",
            "Edit(**/wire_gen.go)",
            "Edit(**/*.g.dart)",
            "Edit(**/*.freezed.dart)",
            "Edit(**/*.g.cs)",
            "Edit(**/*.designer.cs)",
            "Edit(**/*.Designer.cs)",
            "Edit(**/*.min.js)",
            "Edit(**/*.min.css)",
            "Edit(**/*.js.map)",
            "Edit(**/*.css.map)",
            "Edit(**/*.pyc)",
            "Edit(**/*.pyo)",
            "Edit(**/*.pyd)",
            "Edit(**/__pycache__/**)",
            "Edit(**/*.egg-info/**)",
            "Edit(**/*.class)",
            "Edit(**/*.jar)",
            "Edit(**/*.war)",
            "Edit(**/*.ear)",
            "Edit(**/*.dex)",
            "Edit(**/*.beam)",
            "Edit(**/*.o)",
            "Edit(**/*.obj)",
            "Edit(**/*.a)",
            "Edit(**/*.lib)",
            "Edit(**/*.so)",
            "Edit(**/*.dylib)",
            "Edit(**/*.dll)",
            "Edit(**/*.exe)",
            "Edit(**/*.pdb)",
            "Edit(**/*.wasm)"
        ],
        "allow": [
          "Bash(go mod *)",
          "Bash(yarn install)",
          "Bash(pnpm install)"
        ],
        "ask": [
            "Read(~/.zshrc)",
            "Read(~/.zshprofile)",
            "Read(~/.bashrc)",
            "Read(~/.bashprofile)",
            "Read(~/.profile)",
            "Edit(**/go.mod)",
            "Edit(**/package.json)",
            "Edit(**/Cargo.toml)",
            "Edit(**/pyproject.toml)",
            "Edit(**/requirements.txt)",
            "Edit(**/Pipfile)",
            "Edit(**/deno.json)",
            "Edit(**/bunfig.toml)",
            "Edit(**/composer.json)",
            "Edit(**/Podfile)",
            "Edit(**/mix.exs)",
            "Edit(**/flake.nix)",
            "Edit(**/CMakeLists.txt)",
            "Edit(**/Chart.yaml)",
            "Edit(**/*.csproj)",
            "Edit(**/*.fsproj)",
            "Edit(**/*.vcxproj)",
            "Edit(**/*.sln)",
            "Edit(**/pom.xml)",
            "Edit(**/build.gradle)",
            "Edit(**/*.gradle.kts)",
            "Edit(**/settings.gradle)",
            "Edit(**/settings.gradle.kts)",
            "Edit(**/gradle.properties)",
            "Edit(**/pnpm-workspace.yaml)",
            "Edit(**/generated/**)",
            "Edit(**/__generated__/**)",
            "Edit(**/*.generated.*)",
            "Edit(**/dist/**)",
            "Edit(**/build/**)",
            "Edit(**/out/**)",
            "Edit(**/target/**)",
            "Edit(**/*.snap)",
            "Edit(**/*.d.ts)"
        ]
    },
    "env": {
      "CLAUDE_CODE_DISABLE_ARTIFACT": "1",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "3",
        "CLAUDE_CODE_FORK_SUBAGENT": "1",
        "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "9999",
        "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "1",
        "CLAUDE_CODE_PLUGIN_PREFER_HTTPS": "1",
        "CLAUDE_CODE_DISABLE_BG_EXIT_HANDOFF": "1",
        "CLAUDE_CODE_DISABLE_CRON": "1",
        "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
        "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
        "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
        "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
        "NO_PROXY": "localhost,127.0.0.1,192.168.0.0/16,10.0.0.0/8,*.cn",
        "FORCE_AUTOUPDATE_PLUGINS": "1",
        "DO_NOT_TRACK": "1",
        "CLAUDE_CODE_EFFORT_LEVEL": "medium",
        "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
        "ENABLE_TOOL_SEARCH": "true",
        "ENABLE_PROMPT_CACHING_1H": "1",
        "CLAUDE_CODE_MCP_ALLOWLIST_ENV": "1",
        "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1"
    },
    "extraKnownMarketplaces": {
        "caveman": {
            "autoUpdate": true,
            "source": {
                "repo": "JuliusBrussee/caveman",
                "source": "github"
            }
        },
        "ccplugin-market": {
            "autoUpdate": true,
            "source": {
                "repo": "lazygophers/ccplugin",
                "source": "github"
            }
        },
        "claude-code-warp": {
            "autoUpdate": true,
            "source": {
                "repo": "warpdotdev/claude-code-warp",
                "source": "github"
            }
        },
        "i-have-adhd": {
            "autoUpdate": true,
            "source": {
                "repo": "ayghri/i-have-adhd",
                "source": "github"
            }
        },
        "ponytail": {
            "autoUpdate": true,
            "source": {
                "repo": "DietrichGebert/ponytail",
                "source": "github"
            }
        }
    }
}
