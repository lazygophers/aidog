[package]
name = "aidog_backup"
edition = { workspace = true }
version = { workspace = true }
authors = { workspace = true }
license = { workspace = true }

# 票 07：本 crate 也用 aidog_core 的 `tauri_command!` 定义命令，两种展开形态的开关
# 必须在**调用宏的 crate** 上声明（cfg 在展开处求值），并转发给 aidog_core。
[features]
default = ["desktop", "http"]
desktop = ["dep:tauri", "aidog_core/desktop"]
http = ["aidog_core/http"]

# aidog_backup：备份域（调度器 + 加密导出/导入命令，拆自 aidog_core::gateway::backup 与
# system_cmd::backup，2026-08-16）。collect/encrypt 复用 aidog_core::gateway::import_export。
[dependencies]
# 必须 default-features = false：aidog_core 的默认 features 含 desktop，会把 tauri →
# wry/tao → gtk3 拉进无头内核的依赖图（headless Linux 上直接构建失败）。desktop 由本
# crate 的同名 feature 转发。
aidog_core = { path = "../aidog_core", default-features = false }
aidog_db = { path = "../aidog_db" }
serde = { workspace = true }
serde_json = { workspace = true }
tracing = { workspace = true }
chrono = { workspace = true }
aidog_ctx = { path = "../aidog_ctx" }
tokio = { workspace = true }
dirs = { workspace = true }
aidog_notification = { path = "../aidog_notification" }
# `desktop` 展开出的 `#[tauri::command]` 落在**本 crate**里，所以 tauri 必须是本 crate 的
# 直接依赖；`http` 单形态（无头内核）下不链它。
tauri = { workspace = true, optional = true }

[dev-dependencies]
tokio = { workspace = true }
dirs = { workspace = true }
tempfile = { workspace = true }
aidog_stats = { path = "../aidog_stats" }
