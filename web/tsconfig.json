{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "@aidog-i18n/*": ["../src-tauri/crates/aidog_i18n/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "../src/**/*.ts", "../src/**/*.tsx", "../src-tauri/crates/aidog_i18n/locales/*.json"],
  "exclude": [
    "../src/**/*.test.ts",
    "../src/**/*.test.tsx",
    "../src/**/*.spec.ts",
    "../src/**/*.spec.tsx",
    "../src/test"
  ]
}
